# Скопируйте в .env или выполните: python -m app.manage setup
# Настоящий .env не загружайте в GitHub. Подробности: ENV.md.
# Токен вашего Telegram-бота из @BotFather.
BOT_TOKEN=
# Числовые ID получателей уведомлений, через запятую: 123456789,987654321
# Каждый получатель должен первым отправить боту /start.
ADMIN_IDS=
# Логин для входа в ВЕБ-админку; это не Telegram username.
ADMIN_USERNAME=admin
# Хеш пароля веб-админки, не сам пароль. setup создаст автоматически.
# Для отдельного создания хеша: python -m app.manage password
ADMIN_PASSWORD_HASH=
# Отдельный случайный секрет подписи сессий, минимум 32 символа.
# setup создаст автоматически. Отдельно: python -m app.manage secret
SESSION_SECRET=
# false для локального HTTP/SSH-туннеля; true для VPS с HTTPS.
COOKIE_SECURE=false
# Общий HTTPS-домен мини-приложений; можно вместо этого указать в админке.
PUBLIC_URL=
# Необязательно: путь к проверенному PEM-файлу дополнительных корневых CA для MAX.
# Проверка TLS всегда включена. Подробности: MESSENGERS.md.
MAX_CA_BUNDLE=
# Папка базы, фото и резервных копий. При обновлении её сохраняют.
DATA_DIR=./data
# Название и валюта при первом создании базы.
# После первого запуска меняйте их в веб-админке, раздел Настройки.
SHOP_NAME=Осень Кусна
CURRENCY=₽
